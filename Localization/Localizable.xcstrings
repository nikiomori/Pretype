    "Hold a key and speak. Transcribed by your API provider." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte klávesu a mluvte. Přepisuje váš poskytovatel API."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taste halten und sprechen. Transkription durch Ihren API-Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén una tecla y habla. Lo transcribe tu proveedor de API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez une touche et parlez. Transcrit par votre fournisseur d’API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un tasto e parla. Trascritto dal tuo fornitore API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーを押したまま話します。APIプロバイダが文字に変換します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키를 누른 채 말하세요. API 제공업체가 텍스트로 변환합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een toets vast en spreek. Omgezet door je API-aanbieder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj klawisz i mów. Transkrypcja u Twojego dostawcy API."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
