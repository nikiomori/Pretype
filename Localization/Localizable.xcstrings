    "Median time per suggestion: %lld ms, warm — longer bar = faster." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медианное время на подсказку после прогрева: %lld мс — чем длиннее полоса, тем быстрее."
          }
        }
      }
    },
    "Medium" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
