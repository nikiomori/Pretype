    "Model map — accuracy, speed and memory of every model. Switch to the list view to choose a model by name." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa modelů — přesnost, rychlost a paměť každého modelu. Chcete-li vybrat model podle názvu, přepněte na seznam."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellkarte – Genauigkeit, Geschwindigkeit und Speicher jedes Modells. Wechseln Sie zur Listenansicht, um ein Modell nach Namen zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa de modelos: precisión, velocidad y memoria de cada modelo. Cambia a la vista de lista para elegir un modelo por su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte des modèles — précision, vitesse et mémoire de chaque modèle. Passez à la vue en liste pour choisir un modèle par son nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa dei modelli: precisione, velocità e memoria di ogni modello. Passa alla vista elenco per scegliere un modello per nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルマップ — 各モデルの精度、速度、メモリ。名前でモデルを選ぶには、リスト表示に切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 맵 — 모든 모델의 정확도, 속도, 메모리. 이름으로 모델을 선택하려면 목록 보기로 전환하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelkaart – nauwkeurigheid, snelheid en geheugen van elk model. Schakel over naar de lijstweergave om een model op naam te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa modeli — dokładność, szybkość i pamięć każdego modelu. Aby wybrać model po nazwie, przełącz na widok listy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa de modelos: precisão, velocidade e memória de cada modelo. Mude para a visualização em lista para escolher um modelo pelo nome."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta modelelor — acuratețea, viteza și memoria fiecărui model. Comutați la vizualizarea listă pentru a alege un model după nume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта моделей — точность, скорость и память каждой модели. Чтобы выбрать модель по названию, переключитесь на список."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellkarta — träffsäkerhet, hastighet och minne för varje modell. Byt till listvyn för att välja en modell efter namn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model haritası — her modelin doğruluğu, hızı ve belleği. Modeli adıyla seçmek için liste görünümüne geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта моделей — точність, швидкість і пам’ять кожної моделі. Щоб вибрати модель за назвою, перейдіть до списку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型分布图：显示每个模型的准确率、速度和内存。如需按名称选择模型，请切换到列表视图。"
          }
        }
      }
    },
