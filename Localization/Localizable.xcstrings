        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のキー入力でモデルをディスクから再読み込みします。テキストフィールドに切り替えると、事前に準備します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 키 입력 시 디스크에서 모델을 다시 로드합니다. 텍스트 필드로 전환하면 미리 준비합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De volgende toetsaanslag laadt het model opnieuw van schijf; naar een tekstveld gaan warmt het alvast op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Następne naciśnięcie klawisza ponownie wczyta model z dysku; przejście do pola tekstowego rozgrzewa go zawczasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A próxima tecla recarrega o modelo do disco; ir para um campo de texto o pré-aquece."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Următoarea apăsare de tastă reîncarcă modelul de pe disc; trecerea într-un câmp de text îl preîncălzește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующее нажатие клавиши снова загрузит модель с диска; переход в текстовое поле прогревает её заранее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nästa tangenttryckning läser in modellen från disken igen; om du går till ett textfält förvärms den."
