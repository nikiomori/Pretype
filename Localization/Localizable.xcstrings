    "macOS is holding this one: allow Pretype in System Settings → General → Login Items." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS čeká na vaše povolení: zapněte Pretype v „Nastavení systému“ → „Obecné“ → „Položky otevírané po přihlášení“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wartet auf Ihre Freigabe: Erlauben Sie Pretype unter Systemeinstellungen → Allgemein → Anmeldeobjekte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lo está reteniendo: permite Pretype en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bloque celui-ci : autorisez Pretype dans Réglages Système → Général → Ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lo tiene in sospeso: consenti Pretype in Impostazioni di Sistema → Generali → Elementi login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが保留しています：「システム設定」→「一般」→「ログイン項目」でPretypeを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 보류 중: ‘시스템 설정’ → ‘일반’ → ‘로그인 항목’에서 Pretype을 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS houdt dit tegen: sta Pretype toe via Systeeminstellingen → Algemeen → Inlogonderdelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS czeka na Twoją zgodę: włącz Pretype w „Ustawienia systemowe” → „Ogólne” → „Rzeczy otwierane podczas logowania”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS está retendo isto: permita o Pretype em Ajustes do Sistema → Geral → Itens de Início."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS o reține: permiteți Pretype în Configurări sistem → General → Articole de autentificare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ждёт вашего разрешения: включите Pretype в разделе «Системные настройки» → «Основные» → «Объекты входа»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS håller kvar den här: tillåt Pretype i Systeminställningar → Allmänt → Inloggningsobjekt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bunu bekletiyor: Sistem Ayarları → Genel → Giriş Öğeleri bölümünde Pretype’a izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS чекає на ваш дозвіл: увімкніть Pretype у розділі «Системні параметри» → «Загальні» → «Елементи входу»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
