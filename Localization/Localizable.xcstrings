    "Delete the downloaded weights (%@, incl. any %@ rewrite sibling) — picking this model again re-downloads them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazat stažené váhy (%@, včetně případného modelu oprav pro %@) — při opětovném výběru modelu se znovu stáhnou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heruntergeladene Gewichte löschen (%@, inkl. eines Korrekturmodells für %@) – wenn Sie das Modell erneut wählen, werden sie neu geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los pesos descargados (%@, incluido el modelo de reescritura para %@) — si vuelves a elegir este modelo, se descargan de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer les poids téléchargés (%@, y compris l’éventuel modèle de réécriture %@) — choisir à nouveau ce modèle les retélécharge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina i pesi scaricati (%@, incluso l'eventuale modello di riscrittura per %@): se scegli di nuovo questo modello, verranno riscaricati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みの重み（%@、%@用の修正モデルを含む）を削除します。このモデルを再び選ぶと、もう一度ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 가중치(%@, %@ 수정용 모델 포함)를 삭제합니다. 이 모델을 다시 선택하면 다시 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder de gedownloade gewichten (%@, incl. een correctiemodel voor %@) – als je dit model opnieuw kiest, worden ze opnieuw gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń pobrane wagi (%@, w tym model poprawek dla %@) — ponowny wybór modelu pobierze je jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga os pesos baixados (%@, incluindo o modelo de reescrita para %@) — escolher este modelo de novo os baixa outra vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șterge ponderile descărcate (%@, inclusiv modelul pentru corectare cu %@) — dacă alegeți din nou modelul, acestea se descarcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить загруженные веса (%@, включая модель для исправления по %@) — при повторном выборе модели они загрузятся заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radera de hämtade vikterna (%@, inkl. eventuell syskonmodell för rättning med %@) — om du väljer modellen igen hämtas de på nytt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen ağırlıkları sil (%@, %@ için kullanılan düzeltme modeli dahil) — bu model yeniden seçilirse tekrar indirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
