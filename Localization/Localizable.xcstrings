    "Paused by secure input — a password field or Secure Keyboard Entry is on" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastaveno kvůli zabezpečenému vstupu — je aktivní pole hesla nebo „Zabezpečené zadávání z klávesnice“"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert wegen sicherer Eingabe – ein Passwortfeld oder „Sichere Tastatureingabe“ ist aktiv"
