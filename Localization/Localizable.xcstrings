    "Learned from your suggestion journal, only while on. Clear the journal to forget them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učí se z deníku návrhů, jen když je volba zapnutá. Chcete-li je zapomenout, vymažte deník."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus Ihrem Vorschlagsjournal gelernt, nur solange aktiviert. Leeren Sie das Journal, um sie zu vergessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aprenden del historial de sugerencias, solo mientras está activado. Borra el historial para olvidarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appris de votre journal des suggestions, uniquement lorsque l’option est activée. Effacez le journal pour les oublier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parole apprese dal registro dei suggerimenti, solo se attivo. Cancella il registro per dimenticarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンの間だけ候補ジャーナルから学習します。忘れさせるにはジャーナルを消去してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜져 있는 동안에만 제안 저널에서 학습합니다. 잊게 하려면 저널을 지우세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geleerd uit je suggestielogboek, alleen als dit aan staat. Wis het logboek om ze te vergeten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słowa są pobierane z dziennika podpowiedzi, tylko gdy ta opcja jest włączona. Aby je zapomnieć, wyczyść dziennik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendidas do histórico de sugestões, só enquanto ativado. Limpe o histórico para esquecê-las."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Învățate din jurnalul de sugestii, doar cât opțiunea e activată. Goliți jurnalul ca să fie uitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слова берутся из журнала подсказок, только пока параметр включён. Чтобы забыть их, очистите журнал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inlärda från förslagsjournalen, bara när det är på. Rensa journalen för att glömma dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca açıkken öneri günlüğünüzden öğrenilir. Unutturmak için günlüğü temizleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слова беруться з журналу підказок, лише поки параметр увімкнено. Щоб забути їх, очистьте журнал."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在开启时从建议日志中学习。清除日志即可忘记这些词。"
