    "Each recording goes to %@ when you stop speaking, with names from the field as spelling hints. Audio is never saved to disk." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá nahrávka se odešle na %@, jakmile přestanete mluvit, spolu se jmény z pole jako nápovědou k pravopisu. Zvuk se nikdy neukládá na disk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Aufnahme geht an %@, sobald Sie aufhören zu sprechen, mit Namen aus dem Feld als Schreibhilfe. Audio wird nie auf der Festplatte gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada grabación se envía a %@ cuando dejas de hablar, con los nombres del campo como pistas de ortografía. El audio nunca se guarda en el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque enregistrement est envoyé à %@ quand vous cessez de parler, avec les noms du champ comme indications d’orthographe. L’audio n’est jamais enregistré sur le disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni registrazione viene inviata a %@ quando smetti di parlare, con i nomi presenti nel campo come indicazioni di ortografia. L'audio non viene mai salvato su disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話し終えると、録音はフィールド内の名前を表記のヒントとして添えて%@に送信されます。音声がディスクに保存されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말을 멈추면 각 녹음이 필드의 이름을 철자 힌트로 삼아 %@(으)로 전송됩니다. 오디오는 디스크에 저장되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke opname gaat naar %@ zodra je stopt met praten, met namen uit het veld als spellinghulp. Audio wordt nooit op schijf bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde nagranie trafia do %@, gdy przestaniesz mówić, razem z nazwami z pola jako wskazówkami pisowni. Dźwięk nigdy nie jest zapisywany na dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada gravação vai para %@ quando você para de falar, com os nomes do campo como dicas de grafia. O áudio nunca é salvo no disco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare înregistrare este trimisă la %@ când terminați de vorbit, cu nume din câmp ca indicii de ortografie. Audio nu este salvat niciodată pe disc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая запись отправляется на %@, когда вы перестаёте говорить, вместе с именами из поля ввода — для верного написания. Аудио никогда не сохраняется на диск."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje inspelning skickas till %@ när du slutar tala, med namn från fältet som stavningstips. Ljud sparas aldrig på disk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşmayı bitirdiğinizde her kayıt, alandaki adlar yazım ipucu olarak eklenip %@ adresine gönderilir. Ses asla diske kaydedilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен запис надсилається на %@, коли ви перестаєте говорити, разом з іменами з поля — для правильного написання. Аудіо ніколи не зберігається на диск."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每段录音会在你停止说话时发送到 %@，并附上文本栏中的名称作为拼写提示。音频绝不会存储到磁盘。"
          }
        }
      }
    },
