    "Keeps wireless headphones out of call mode." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не переводит беспроводные наушники в режим звонка."
          }
        }
      }
    },
    "Keeps ~%@ GB resident — over a quarter of this Mac's %@ GB, the line the auto-picked model stays under. Everything else you run gets that much less room." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Занимает ~%@ ГБ в памяти — больше четверти из %@ ГБ этого Mac, а автоматически выбранная модель держится ниже этой границы. Всему остальному остаётся настолько же меньше места."
          }
        }
      }
    },
    "LM Studio (local)" : {
      "localizations" : {
