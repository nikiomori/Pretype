    "Follows the keyboard layout that's active when you start — switch layouts to switch dictation language." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použije rozložení klávesnice aktivní na začátku nahrávání — přepnutím rozložení přepnete jazyk diktování."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt der beim Start aktiven Tastaturbelegung – wechseln Sie die Belegung, um die Diktatsprache zu wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue la distribución de teclado activa al empezar: cambia de distribución para cambiar el idioma del dictado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit la disposition de clavier active au début — changez de disposition pour changer la langue de dictée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue il layout di tastiera attivo all'avvio: cambia layout per cambiare la lingua di dettatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始時の入力ソースに従います。音声入力の言語を変えるには、入力ソースを切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작할 때 활성화된 입력 소스를 따릅니다. 받아쓰기 언어를 바꾸려면 입력 소스를 전환하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgt de toetsenbordindeling die actief is als je begint – wissel van indeling om de dicteertaal te wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa układu klawiatury aktywnego w chwili rozpoczęcia — zmień układ, aby zmienić język dyktowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
