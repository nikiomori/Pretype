    "Now %@. Changing Style or Length turns this off." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyní: %@. Změna stylu nebo délky tuto volbu vypne."
          }
        },
        "de" : {
