    "Off pauses suggestions, fix, reply and dictation — same as Pause Pretype in the menu bar" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnutí pozastaví návrhy, opravy, odpovědi i diktování — stejně jako „Pozastavit Pretype“ v řádku nabídek"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus pausiert Vorschläge, Korrektur, Antwort und Diktat – wie „Pretype pausieren“ in der Menüleiste"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivarlo pausa sugerencias, corrección, respuesta y dictado, igual que “Pausar Pretype” en la barra de menús"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé suspend les suggestions, la correction, la réponse et la dictée — comme « Suspendre Pretype » dans la barre des menus"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivare sospende suggerimenti, correzione, risposta e dettatura, come «Sospendi Pretype» nella barra dei menu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると候補、修正、返信、音声入力が一時停止します（メニューバーの「Pretypeを一時停止」と同じ）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 제안, 수정, 답장, 받아쓰기가 일시 정지됩니다. 메뉴 막대의 ‘Pretype 일시 정지’와 같습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit pauzeert suggesties, correctie, antwoorden en dicteren – net als “Pauzeer Pretype” in de menubalk"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączenie wstrzymuje podpowiedzi, poprawki, odpowiedzi i dyktowanie — tak jak „Wstrzymaj Pretype” na pasku menu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar pausa sugestões, correção, resposta e ditado — o mesmo que “Pausar Pretype” na barra de menus"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivarea întrerupe sugestiile, corectarea, răspunsurile și dictarea — la fel ca „Întrerupe Pretype” din bara de meniuri"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключение приостанавливает подсказки, исправление, ответы и диктовку — как «Приостановить Pretype» в строке меню"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av pausar förslag, rättning, svar och diktering — samma som ”Pausa Pretype” i menyraden"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken öneriler, düzeltme, yanıt ve dikte duraklatılır — menü çubuğundaki “Pretype’ı Duraklat” ile aynı"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнення призупиняє підказки, виправлення, відповіді й диктування — як «Призупинити Pretype» у смузі меню"
          }
        },
        "zh-Hans" : {
