          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmează aspectul de tastatură activ la pornire — schimbați aspectul pentru a schimba limba dictării."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
