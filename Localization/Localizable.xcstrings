    "Say an edit like “make this shorter” over a selection." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úprava hlasem, například „zkrať to“, nad vybraným textem."
          }
        },
        "de" : {
