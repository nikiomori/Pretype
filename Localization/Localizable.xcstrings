        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub에 연결할 수 없습니다. 나중에 다시 시도하거나 릴리스 페이지를 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
