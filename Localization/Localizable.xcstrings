    },
    "The next keystroke reloads the model from disk; switching to a text field pre-warms it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Další stisk klávesy model znovu načte z disku; přechod do textového pole ho předem zahřeje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der nächste Tastendruck lädt das Modell erneut von der Festplatte; der Wechsel in ein Textfeld wärmt es vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La próxima pulsación vuelve a cargar el modelo desde el disco; ir a un campo de texto lo precalienta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prochaine frappe recharge le modèle depuis le disque ; passer dans un champ de texte le préchauffe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prossimo tasto ricarica il modello dal disco; passare a un campo di testo lo prepara in anticipo."
