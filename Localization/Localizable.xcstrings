        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki tuş vuruşu modeli diskten yeniden yükler; bir metin alanına geçmek modeli önceden ısıtır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наступне натискання клавіші знову завантажить модель з диска; перехід у текстове поле прогріває її заздалегідь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
