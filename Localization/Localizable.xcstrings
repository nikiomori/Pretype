            "value" : "단축키를 다시 누를 때까지, 최대 10분 동안 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loopt tot je de combinatie opnieuw indrukt, maximaal tien minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa, dopóki ponownie nie naciśniesz skrótu, ale nie dłużej niż dziesięć minut."
          }
        },
