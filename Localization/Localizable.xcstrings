        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Țineți apăsată o tastă și vorbiți. Transcris de furnizorul API."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
