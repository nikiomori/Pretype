    "Ghost text right at the cursor. It can leave drawing glitches in some apps." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šedý text přímo u kurzoru. V některých aplikacích může způsobit chyby vykreslování."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grauer Text direkt am Cursor. In manchen Apps kann es zu Darstellungsfehlern kommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto gris justo en el cursor. Puede dejar fallos de dibujo en algunas apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte grisé directement au curseur. Peut laisser des défauts d’affichage dans certaines apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo fantasma direttamente al cursore. In alcune app può lasciare difetti grafici."
          }
        },
        "ja" : {
