    "Up to 600 characters, read only when the clipboard changes. Copies from password managers are never read, and nothing is written to the journal or debug log." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až 600 znaků, čte se jen při změně schránky. Obsah zkopírovaný ze správců hesel se nikdy nečte a nic se nezapisuje do deníku ani ladicího protokolu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu 600 Zeichen, nur gelesen, wenn sich die Zwischenablage ändert. Kopien aus Passwort-Managern werden nie gelesen, und nichts wird ins Journal oder Debug-Protokoll geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta 600 caracteres, que solo se leen cuando cambia el portapapeles. Nunca se lee lo copiado de gestores de contraseñas, y no se guarda nada en el historial ni en el registro de depuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à 600 caractères, lus uniquement quand le presse-papiers change. Les copies depuis les gestionnaires de mots de passe ne sont jamais lues, et rien n’est écrit dans le journal ni dans le journal de débogage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a 600 caratteri, letti solo quando gli appunti cambiano. Le copie dai gestori di password non vengono mai lette e nulla viene scritto nel registro o nel log di debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大600文字。クリップボードが変更されたときだけ読み取ります。パスワードマネージャからのコピーは読み取らず、ジャーナルやデバッグログにも何も書き込みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 600자이며, 클립보드가 바뀔 때만 읽습니다. 암호 관리자에서 복사한 내용은 읽지 않으며, 저널이나 디버그 로그에 아무것도 기록하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot 600 tekens, alleen gelezen als het klembord verandert. Kopieën uit wachtwoordbeheerders worden nooit gelezen en er wordt niets naar het logboek of de debuglog geschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do 600 znaków, odczytywane tylko przy zmianie schowka. Kopie z menedżerów haseł nigdy nie są odczytywane i nic nie trafia do dziennika podpowiedzi ani dziennika debugowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até 600 caracteres, lidos só quando a área de transferência muda. O que é copiado de gerenciadores de senhas nunca é lido, e nada é gravado no histórico ou no registro de depuração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Până la 600 de caractere, citite doar când se schimbă clipboardul. Copierile din managerele de parole nu sunt citite niciodată și nimic nu este scris în jurnalul de sugestii sau de depanare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До 600 символов, читается только при изменении буфера обмена. Скопированное из менеджеров паролей не читается, и ничего не записывается в журнал подсказок или отладочный лог."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upp till 600 tecken, läses bara när urklippet ändras. Kopior från lösenordshanterare läses aldrig, och inget skrivs till journalen eller felsökningsloggen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla 600 karakter; yalnızca pano değiştiğinde okunur. Parola yöneticilerinden kopyalananlar asla okunmaz, günlüğe veya hata ayıklama kaydına hiçbir şey yazılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До 600 символів, читається лише після зміни буфера обміну. Скопійоване з менеджерів паролів не читається, і нічого не записується в журнал підказок чи журнал налагодження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多 600 个字符，仅在剪贴板变化时读取。绝不会读取从密码管理器拷贝的内容，也不会写入建议日志或调试日志。"
          }
        }
      }
    },
    "Up to a sentence ahead, about %@ each." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až celá věta dopředu, asi %@ na návrh."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu einem Satz voraus, je etwa %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta una frase por delante, unos %@ por sugerencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à une phrase d’avance, environ %@ par suggestion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a una frase in anticipo, circa %@ per suggerimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大1文先まで。1回あたり約%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 한 문장 앞까지, 제안당 약 %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot een zin vooruit, elk ongeveer %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do całego zdania naprzód, ok. %@ na podpowiedź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até uma frase à frente, cerca de %@ por sugestão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Până la o propoziție înainte, circa %@ per sugestie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До целого предложения, около %@ на подсказку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upp till en mening framåt, cirka %@ per förslag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İleriye bir cümleye kadar, öneri başına yaklaşık %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До цілого речення, близько %@ на підказку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多补全一整句，每条约 %@。"
          }
        }
      }
    },
