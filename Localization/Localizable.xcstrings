            "value" : "2–3 mots d’avance, environ %@ par suggestion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2–3 parole in anticipo, circa %@ per suggerimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2〜3語先まで。1回あたり約%@。"
