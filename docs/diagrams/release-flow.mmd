%% Release flow: the maintainer builds and notarizes on a Mac, then attaches that zip to a draft release.
flowchart TB
  subgraph mac["Maintainer's Mac"]
    direction LR
    tag["1. Push tag vX.Y.Z"] --> build["2. Build from the tag<br/>make-app.sh"]
    build --> notar["Sign, notarize, staple<br/>dist.sh"]
  end
  subgraph pub["GitHub and Homebrew"]
    direction LR
    draft["3. Create a draft release<br/>with the zip"] --> verify["4. Download and verify<br/>spctl, stapler"]
    verify --> publish["5. Publish the draft"]
    publish --> cask["6. Bump the Homebrew cask<br/>version + sha256"]
  end
  notar --> draft
